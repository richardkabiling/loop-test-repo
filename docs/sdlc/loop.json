  "guardrails": [
    {
      "id": "nit-flood",
      "failure_mode": "Reviewer floods the PR with nits; real issues get lost",
      "phases": [
        "design",
        "review"
      ],
      "mitigation": "Cap nits at 5; review for correctness and spec gaps only; skip what linters enforce",
      "enforced_by": "REVIEW.md + reviewer prompt",
      "deterministic": false,
      "source": "default",
      "basis": "propose.py; https://claude.com/resources/articles/the-ai-native-sdlc-playbook"
    },
    {
      "id": "test-tampering",
      "failure_mode": "Agent skips, deletes or weakens tests to go green",
      "phases": [
        "build"
      ],
      "mitigation": "Block skipped/deleted tests and net assertion loss unless a human approves",
      "enforced_by": "diff-guard.sh in the Stop hook, the pre-commit hook and pr-checks.sh",
      "deterministic": true,
      "source": "default",
      "basis": "propose.py; https://claude.com/resources/articles/the-ai-native-sdlc-playbook"
    },
    {
      "id": "premature-completion",
      "failure_mode": "Agent declares done without verifying",
      "phases": [
        "build"
      ],
      "mitigation": "Exit criteria per phase; Stop hook runs typecheck + tests; validation evidence required before the PR",
      "enforced_by": "stop-check.sh + PR template",
      "deterministic": true,
      "source": "default",
      "basis": "propose.py; https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents"
    },
    {
      "id": "self-approval",
      "failure_mode": "Authoring agent (or a lenient evaluator) approves its own work",
      "phases": [
        "design",
        "review",
        "ship"
      ],
      "mitigation": "Fresh-context reviewer; AI never approves; human code owner via branch protection + conversation resolution",
      "enforced_by": "branch protection or rulesets; validator requires a human gate on the review phase and a human approval in every PR tier",
      "deterministic": true,
      "source": "default",
      "basis": "propose.py; https://www.anthropic.com/engineering/harness-design-long-running-apps"
    },
    {
      "id": "scope-creep",
      "failure_mode": "Unrequested changes and giant diffs",
      "phases": [
        "plan",
        "build"
      ],
      "mitigation": "plan.md names files; one ticket per session; warn above 400 changed lines / 30 files",
      "enforced_by": "diff-guard.sh --max-lines 400 --max-files 30 --size warn",
      "deterministic": true,
      "source": "default",
      "basis": "propose.py; https://github.com/google/eng-practices/blob/master/review/developer/small-cls.md"
    },
    {
      "id": "hallucinated-deps",
      "failure_mode": "Invented packages or APIs (slopsquatting)",
      "phases": [
        "build"
      ],
      "mitigation": "New dependencies must exist in their registry; typecheck catches fake APIs",
      "enforced_by": "diff-guard.sh --check-registry in pr-checks.sh (review phase)",
      "deterministic": true,
      "source": "default",
      "basis": "propose.py; docs/research/04-review-interaction-and-failure-modes.md"
    },
    {
      "id": "runaway",
      "failure_mode": "Unbounded loops and cost in unattended runs",
      "phases": [
        "build"
      ],
      "mitigation": "max turns, budget and iterations; CI timeout + concurrency; Stop-hook block cap 3",
      "enforced_by": "loops.autonomy.limits; stop-check.sh --max-blocks 3",
      "deterministic": true,
      "source": "default",
      "basis": "propose.py; https://code.claude.com/docs/en/best-practices"
    },
    {
      "id": "secret-leak",
      "failure_mode": "Secrets read, printed or committed",
      "phases": [
        "build"
      ],
      "mitigation": "Block reads of .env (not .env.example); secret scanning (forge setting or the existing CI)",
      "enforced_by": "protect-paths.sh (protect: read); permissions.deny",
      "deterministic": true,
      "source": "default",
      "basis": "propose.py; https://code.claude.com/docs/en/best-practices"
    }
  ],
