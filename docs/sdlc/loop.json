  "review": {
    "default_venue": "both",
    "artifacts": [
      {
        "artifact": "intent",
        "venue": "pr",
        "reviewers": [
          {
            "type": "human",
            "role": "product-owner"
          }
        ],
        "record": "PR review on the docs PR (intent.md)",
        "blocking": "PO approval is the gate"
      },
      {
        "artifact": "design",
        "venue": "both",
        "reviewers": [
          {
            "type": "ai",
            "how": "fresh-context reviewer subagent",
            "when": "before the gate request"
          },
          {
            "type": "human",
            "role": "product-owner"
          }
        ],
        "record": "AI findings resolved in spec.md 'Review log'; human review on the PR",
        "blocking": "PO approval is the gate; AI review is advisory"
      },
      {
        "artifact": "plan",
        "venue": "local",
        "reviewers": [
          {
            "type": "ai",
            "how": "fresh-context plan reviewer subagent",
            "when": "before tickets are created"
          }
        ],
        "record": "plan.md 'Review log'; engineer notified with the plan link",
        "blocking": "automated gate: AI review must report no blocking findings; escalates to the engineer for high-risk plans"
      },
      {
        "artifact": "validate",
        "venue": "local",
        "reviewers": [
          {
            "type": "automated",
            "how": "typecheck, tests, diff-guard, ticket verify command"
          }
        ],
        "record": "progress.md evidence",
        "blocking": "automated build gate; no AI or human review by default"
      },
      {
        "artifact": "code",
        "venue": "pr",
        "reviewers": [
          {
            "type": "automated",
            "how": "scripts/sdlc/pr-checks.sh (check-loop, protected paths, diff-guard, tier label) run by /sdlc-review; existing CI as it is",
            "when": "before review is requested"
          },
          {
            "type": "ai",
            "how": "persona lenses (context-less, deduped)",
            "when": "right after the PR is opened, per tier"
          },
          {
            "type": "human",
            "role": "code-owner"
          }
        ],
        "record": "lens findings in reviews/ ledger and one summary comment on the PR; resolved threads",
        "blocking": "approvals per PR tier via branch protection; AI reviewers never approve or block"
      },
      {
        "artifact": "release",
        "venue": "pr",
        "reviewers": [
          {
            "type": "human",
            "role": "release-manager"
          }
        ],
        "record": "protected-environment approval",
        "blocking": "release-manager approval"
      },
      {
        "artifact": "improve",
        "venue": "pr",
        "reviewers": [
          {
            "type": "ai",
            "how": "local reviewer subagent",
            "when": "before the harness PR"
          },
          {
            "type": "human",
            "role": "code-owner"
          }
        ],
        "record": "harness PR with before/after eval results",
        "blocking": "review phase gate (approvals per PR tier)"
      }
    ],
    "pr": {
      "host": "github",
      "filed": "start-of-review",
      "draft": false,
      "title": "imperative summary",
      "body": "PR template + evidence (verify output, screenshots) + tier and why",
      "tiering": "scripts/sdlc/pr-tier.sh computes the tier; /<prefix>-review labels the PR; pr-checks.sh verifies the label",
      "tiers": [
        {
          "id": "standard",
          "default": true,
          "human_approvals": 1,
          "required_roles": [
            "code-owner"
          ],
          "ai": [
            "lenses"
          ],
          "why": "default tier"
        },
        {
          "id": "low",
          "match": [
            "docs/**",
            "**/*.md"
          ],
          "human_approvals": 1,
          "required_roles": [],
          "ai": [],
          "why": "docs-only changes"
        }
      ],
      "source": "default",
      "basis": "propose.py; setup-sdlc-review/references/venues.md#pr-tiers"
    },
    "evals": {
      "run_in": "review",
      "suites": [
        {
          "id": "harness",
          "kind": "harness",
          "where": "local",
          "path": "docs/sdlc/evals/evals.json",
          "triggers": [
            "AGENTS.md",
            "CLAUDE.md",
            "REVIEW.md",
            ".agents/**",
            ".claude/**",
            ".cursor/**",
            "scripts/sdlc/**",
            "docs/sdlc/loop.json",
            "docs/sdlc/lenses/**",
            "docs/sdlc/personas.md"
          ],
          "repeat": 1,
          "threshold": 1.0,
          "timeout_min": 20,
          "max_scenarios": 12,
          "source": "default",
          "basis": "propose.py; setup-sdlc-evals"
        }
      ],
      "agent_cmd": "claude -p --output-format json --max-turns 40 --permission-mode acceptEdits",
      "grader_cmd": "claude -p --output-format json --max-turns 1",
      "max_cost_usd": 10,
      "on_fail": "major finding on the PR: fix and re-run, or a human accepts the regression with a reason",
      "rediscover": "check-loop.sh runs detect-evals.sh and fails when a suite in the repo isn't listed here",
      "source": "default",
      "basis": "propose.py; setup-sdlc-evals"
    },
    "noise_controls": {
      "max_nits": 5,
      "report": "correctness, security, spec gaps; skip style the tools enforce",
      "verify_before_report": true,
      "skip_paths": [
        "generated files",
        "lockfiles"
      ],
      "comment_labels": "conventional-comments",
      "max_review_rounds": 3
    },
    "ai_comment_policy": "AI reviewers comment, never approve; findings carry severity and evidence; one summary comment updated in place",
    "new_reviewer_rollout": "shadow mode: post to a log or draft for two weeks, then promote",
    "source": "default",
    "basis": "propose.py; setup-sdlc-review/references/venues.md",
    "personas": {
      "points": {
        "intent": [
          "naive-reader",
          "end-user",
          "pre-mortem"
        ],
        "design:requirements": [
          "qa-test-designer",
          "naive-reader",
          "intent-conformance"
        ],
        "design:solution": [
          "skeptical-architect",
          "design-critic",
          "security"
        ],
        "design:docs": [
          "new-user",
          "structure-style"
        ],
        "review": [
          "correctness",
          "spec-conformance",
          "test-quality",
          "silent-failure"
        ]
      },
      "max_rounds_doc": 2,
      "surface": {
        "intent": "silent",
        "design": "auto",
        "review": "auto"
      },
      "discovered": [],
      "context": "context-less: fresh subagent per lens, only the review point's inputs + the lens file, no CLAUDE.md, never the conversation",
      "dedupe": "scripts/sdlc/dedupe-findings.py with a per-work-item ledger",
      "source": "default",
      "basis": "https://github.com/google/elephant-goldfish-model; docs/research/05-persona-review.md"
    }
  },
  "skills": {
