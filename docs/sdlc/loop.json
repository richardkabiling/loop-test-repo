  "loops": {
    "upstream": {
      "store": "epic",
      "where": "GitHub epic issue holds the intent and design summaries and the approval; the full intent.md, spec.md and design/*.md are committed in docs/work/<date>-<slug>/ (agent syncs the epic and the files after each round)",
      "grilling": "solo",
      "team_protocol": "",
      "tickets": "GitHub sub-issues of the epic; ids kept in tickets.json",
      "source": "user",
      "basis": "setup-sdlc-loops/references/upstream.md"
    },
    "phases": [
      {
        "id": "intent",
        "enabled": true,
        "purpose": "Capture what and why as intent.md",
        "strategy": "grilling",
        "interaction": "interview",
        "artifact": "GitHub epic + docs/work/<slug>/intent.md",
        "gate": {
          "type": "human",
          "owner": "team-member (not the driver)",
          "mechanism": "'intent-approved' label or approval comment on the epic by any team member except the work item's driver"
        },
        "exit": "Problem, outcome, affected users and systems, constraints and open questions all filled; PO approved",
        "source": "user",
        "basis": "propose.py; https://claude.com/resources/articles/the-ai-native-sdlc-playbook"
      },
      {
        "id": "design",
        "enabled": true,
        "purpose": "Turn the accepted intent into spec.md plus the design subphases the work item needs",
        "strategy": "synthesize-then-goldfish-review",
        "interaction": "review",
        "artifact": "docs/work/<slug>/spec.md",
        "gate": {
          "type": "human",
          "owner": "team-member (not the driver)",
          "mechanism": "'design-approved' label or approval comment on the epic by any team member except the work item's driver"
        },
        "exit": "EARS acceptance criteria; concerns flagged and resolved; fresh-context review passed",
        "source": "user",
        "basis": "propose.py; https://github.com/google/elephant-goldfish-model",
        "subphases": [
          {
            "id": "requirements",
            "when": "always",
            "artifact": "spec.md",
            "approver": "team-member"
          },
          {
            "id": "solution",
            "when": "new component or service, crosses deliverables, changes a boundary, or needs an ADR; includes a STRIDE threat model when a change crosses a trust boundary (public API, IAM, data store)",
            "artifact": "design/solution.md + docs/decisions/ ADR + threat model section",
            "approver": "team-member"
          },
          {
            "id": "api",
            "when": "changes api/openapi.yaml or the backend's HTTP surface",
            "artifact": "design/api.md + OpenAPI diff",
            "approver": "team-member"
          },
          {
            "id": "data",
            "when": "changes persisted Pekko events, serializers or the journal schema",
            "artifact": "design/data.md",
            "approver": "team-member"
          },
          {
            "id": "infra",
            "when": "changes infra/ (Terraform, AWS) or the backend container image; includes a STRIDE threat model for IAM/network changes",
            "artifact": "design/infra.md",
            "approver": "team-member"
          },
          {
            "id": "ux",
            "when": "touches frontend/ UI",
            "artifact": "design/ux.md",
            "approver": "team-member"
          },
          {
            "id": "docs",
            "when": "touches user-guide, tech-ops-manual or business-ops-manual",
            "artifact": "design/docs.md",
            "approver": "team-member"
          }
        ]
      },
      {
        "id": "plan",
        "enabled": true,
        "purpose": "plan.md plus vertical-slice tickets with blocking edges",
        "strategy": "plan-mode-then-tracer-tickets",
        "interaction": "review",
        "artifact": "docs/work/<slug>/plan.md",
        "gate": {
          "type": "automated",
          "checks": [
            "plan.md has Files / Order / Risks / Proof",
            "every acceptance criterion maps to a ticket with a verify command",
            "fresh-context AI plan review: no blocking findings"
          ],
          "notify": "driver",
          "escalate_to": "team",
          "escalate_when": "the plan touches infra, ci or migrations, or the AI review reports blocking findings"
        },
        "exit": "plan.md has Files / Order / Risks / Proof; every ticket fits one context window and lists its blockers",
        "source": "default",
        "basis": "propose.py; https://github.com/mattpocock/skills/blob/main/skills/engineering/to-tickets/SKILL.md"
      },
      {
        "id": "build",
        "enabled": true,
        "purpose": "Build-validate: implement each ticket locally, test-first, and validate it before anything is shared",
        "strategy": "tdd-with-stop-hook",
        "interaction": "steer",
        "artifact": "local branch with validation evidence in progress.md",
        "validate": {
          "checks": [
            "typecheck",
            "tests for the changed packages",
            "diff-guard.sh",
            "the ticket's verify command"
          ],
          "tests": "red-green: each acceptance criterion gets a failing test first",
          "review": "none"
        },
        "gate": {
          "type": "automated",
          "checks": [
            "validate checks green",
            "ticket verify command passes",
            "evidence recorded in progress.md"
          ],
          "notify": "driver",
          "escalate_to": "team",
          "escalate_when": "validation still fails after 3 attempts, or an existing test had to change"
        },
        "exit": "Every acceptance criterion of the ticket has a passing test; validate checks green; evidence in progress.md; nothing pushed for review yet",
        "source": "default",
        "basis": "propose.py; https://code.claude.com/docs/en/best-practices"
      },
      {
        "id": "review",
        "enabled": true,
        "purpose": "Open the PR, run the automated and AI reviews its tier calls for, resolve findings, get human approval",
        "strategy": "pr-first-tiered-review",
        "interaction": "review",
        "artifact": "pull request with evidence, tier label and resolved findings",
        "pr_filed": "start",
        "gate": {
          "type": "human",
          "owner": "team-member (not the driver)",
          "mechanism": "approvals per PR tier (review.pr.tiers) through branch protection or rulesets; conversation resolution; the authoring agent can't approve; this approval is the deploy gate: merge to main triggers deploys"
        },
        "exit": "Checks green; AI and lens findings resolved or dismissed with a reason; approvals meet the PR's tier",
        "source": "default",
        "basis": "propose.py; docs/research/07-pr-venues-and-tiering.md"
      },
      {
        "id": "ship",
        "enabled": true,
        "purpose": "Merge to main triggers CD: deploy everything (Terraform apply, image push, API and web deploy) behind flags, with health checks and rollback",
        "strategy": "trunk-based-flags-progressive",
        "interaction": "automated",
        "artifact": "release + release notes",
        "gate": {
          "type": "automated",
          "checks": [
            "merged to main through an approved PR",
            "CD pipeline green",
            "deploy health checks",
            "rollback path verified"
          ],
          "notify": "driver",
          "escalate_to": "team",
          "escalate_when": "a health check fails or the release touches a critical-tier path"
        },
        "exit": "Deployed; health checks green; rollback path verified",
        "source": "default",
        "basis": "propose.py; https://claude.com/resources/articles/the-ai-native-sdlc-playbook; outside approvals (security, architecture, demo, CAB) happen post-merge and are out of scope (user)"
      },
      {
        "id": "improve",
        "enabled": true,
        "purpose": "Turn signals, incidents and session lessons into new intents and evidence-backed harness changes",
        "strategy": "retro-plus-eval-suite",
        "interaction": "interview",
        "artifact": "docs/sdlc/improve/<yyyy-mm-dd>-<slug>.md",
        "gate": {
          "type": "automated",
          "checks": [
            "product findings become intents (they pass the intent gate)",
            "harness changes ship as PRs (they pass the review phase gate)",
            "eval suite passes before and after a harness change"
          ],
          "notify": "team"
        },
        "exit": "Every finding is an intent, a harness PR, or a recorded no-op; evals pass after harness changes",
        "source": "default",
        "basis": "propose.py; https://github.com/google-research/harness2",
        "modes": [
          "retro",
          "incident",
          "tune",
          "scan"
        ],
        "triggers": [
          "after each shipped work item",
          "after an incident",
          "weekly signals report",
          "after a model or tool upgrade"
        ],
        "research": "researcher subagent checks root causes and current practice against primary sources before a harness change; notes in docs/sdlc/research/",
        "evals": "review.evals suite 'harness' (run-evals.sh --suite harness, before on the base and after on the branch)",
        "change_classes": [
          "product",
          "phase",
          "harness",
          "convention",
          "code-part-convention",
          "no-op"
        ]
      }
    ],
    "autonomy": {
      "default_mode": "plan-then-acceptEdits",
      "afk_allowed_for": [
        "all ready-for-agent tickets with executable acceptance criteria: build-validate and review, up to merge to main"
      ],
      "limits": {
        "max_turns": 120,
        "max_failed_validations": 3,
        "max_budget_usd": 25
      },
      "afk": {
        "done": "every acceptance criterion's verify command passes",
        "self_check": "just typecheck, just test, diff-guard.sh, the ticket's verify command; Playwright screenshot diffs for web tickets",
        "may_touch": "any path in the repo, including infra/ and .github/workflows/ (nothing deploys before merge); blocked: push or merge to main, force push, terraform apply, reading or printing secrets; append-only rules for applied migrations and persisted events still apply",
        "stops": "120 turns, 3 failed validations, $25 budget, or completion promise",
        "result": "agent-opened PR; its human approval (any team member except the driver) is the deploy gate"
      },
      "source": "user",
      "basis": "setup-sdlc-loops/references/interaction.md#unattended-runs"
    },
    "human_gates": [
      "intent",
      "design",
      "review"
    ],
    "source": "user",
    "basis": "propose.py"
  },
